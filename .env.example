# Local development configuration. Copy to .env and edit locally; never commit .env.
APP_ENV=development
NODE_ENV=development
PORT=5000
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8000
CORS_ORIGIN=http://127.0.0.1:5173

# Optional PostgreSQL/PostGIS. Change the placeholder before starting Docker PostGIS.
POSTGRES_DB=earth_geo
POSTGRES_USER=earth_geo
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=postgresql://earth_geo:replace-with-a-unique-local-password@127.0.0.1:5432/earth_geo

# Optional credentials / identifiable client information; leave blank unless needed.
NASA_EARTHDATA_TOKEN=
COPERNICUS_ACCESS_TOKEN=
OSM_USER_AGENT=
OSM_HTTP_REFERER=
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
USGS_TNM_ENDPOINT=https://tnmaccess.nationalmap.gov/api/v1/products
